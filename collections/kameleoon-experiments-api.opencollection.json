{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kameleoon Automation Experiments API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Experiments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List experiments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kameleoon.com/experiments",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Kameleoon experiments for the authenticated account."
        },
        {
          "info": {
            "name": "Create an experiment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kameleoon.com/experiments",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new Kameleoon experiment."
        }
      ]
    }
  ],
  "bundled": true
}